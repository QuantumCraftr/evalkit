{
  "name": "evalkit",
  "version": "0.1.0",
  "description": "A small, dependency-free harness to score local LLMs on real tasks: run a pack, get comparable numbers, keep the caveats.",
  "type": "module",
  "bin": { "evalkit": "bin/evalkit.mjs" },
  "files": ["bin", "src", "packs", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "list": "node bin/evalkit.mjs list"
  },
  "keywords": ["llm", "evaluation", "benchmark", "local-ai", "ollama", "llama.cpp"],
  "license": "MIT"
}
